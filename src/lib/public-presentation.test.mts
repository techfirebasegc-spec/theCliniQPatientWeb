import assert from "node:assert/strict";
import test from "node:test";
import { publicPresentation } from "./public-presentation.ts";
for(const templateKey of ["professional","premium","minimal"] as const)test(`${templateKey} presentation is retained`,()=>{const value=publicPresentation({templateKey,rendererKey:`${templateKey}-v1` as "professional-v1"|"premium-v1"|"minimal-v1",primaryColor:"#123456",secondaryColor:null,accentColor:null,layoutOptions:{heroLayout:"centered"},sectionVisibility:{about:false},assets:[{kind:"HERO_IMAGE",url:"/v1/public/doctors/doctor/presentation-assets/HERO_IMAGE"}]});assert.equal(value.templateKey,templateKey);assert.equal(value.primaryColor,"#123456");assert.equal(value.layoutOptions.heroLayout,"centered");assert.equal(value.sectionVisibility.about,false);assert.equal(value.assets.length,1);});
test("invalid values and unavailable assets fall back safely",()=>{const value=publicPresentation({templateKey:"premium",rendererKey:"premium-v1",primaryColor:"bad",secondaryColor:null,accentColor:null,layoutOptions:[] as unknown as Record<string,unknown>,sectionVisibility:null as unknown as Record<string,unknown>,assets:[{kind:"HERO_IMAGE",url:"https://private.example/file"}]});assert.equal(value.primaryColor,null);assert.deepEqual(value.layoutOptions,{});assert.deepEqual(value.sectionVisibility,{});assert.deepEqual(value.assets,[]);});
